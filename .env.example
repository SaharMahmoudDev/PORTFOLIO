# Copy this file to `.env.local` and fill in real values.
# Every variable listed here must also be declared in `src/config/env.ts`.

# NODE_ENV is managed by Next.js — no need to set it manually.

# PostgreSQL connection string (used by the app and by drizzle-kit).
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Admin login (single admin). Generate the hash with:
#   npm run auth:hash
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="\$2b\$12\$..."

# Random 32+ character string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Google Gemini API key that powers the "Ask Sahar's AI" chat widget (free tier).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Resend (https://resend.com) sends the new-message notification to you.
# RESEND_API_KEY alone works in sandbox mode (mail only goes to your Resend account email).
# To also auto-reply to visitors, verify a domain in Resend and set RESEND_FROM, e.g. "Sahar <hello@yourdomain.com>".
RESEND_API_KEY=""
RESEND_FROM=""
# Where notifications are delivered (defaults to the email in src/config/site.ts).
NOTIFY_EMAIL=""

# Free alternative for the visitor auto-reply (no domain needed): a Gmail App Password for the
# address in src/config/site.ts. Requires 2-Step Verification: https://myaccount.google.com/apppasswords
# Used when RESEND_FROM is not set. Replies are sent from that Gmail address.
GMAIL_APP_PASSWORD=""
